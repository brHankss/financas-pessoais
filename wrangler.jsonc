{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "financas-pessoais",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-20",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
  // Após criar o banco D1 na Cloudflare (financas-pessoais-db),
  // você pode vinculá-lo em Settings > Bindings (nome da variável: DB)
  // ou descomentar o bloco abaixo com o database_id gerado na sua conta:
  // "d1_databases": [
  //   {
  //     "binding": "DB",
  //     "database_name": "financas-pessoais-db",
  //     "database_id": "SEU_DATABASE_ID_AQUI"
  //   }
  // ]
}
