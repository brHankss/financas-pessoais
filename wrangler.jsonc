{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "financas-pessoais",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-20",
  "build": { "command": "node scripts/prepare-pdf.mjs" },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "financas-pessoais-db",
      "database_id": "29bb07cd-fd88-45da-ae94-138c6dd82cc5"
    }
  ]
}
